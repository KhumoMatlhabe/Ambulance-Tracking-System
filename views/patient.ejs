<%- include('partials/header', { title: 'Patient Emergency Portal' }) %>

<style>
    .patient-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 30px 15px;
        box-sizing: border-box;
    }
    .patient-dashboard {
        width: 100%;
        max-width: 650px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .portal-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    }
    .portal-card h3 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 1.2rem;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .portal-card label {
        display: block;
        font-size: 0.875rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }
    .portal-card input[type="text"],
    .portal-card input[type="datetime-local"],
    .portal-card input[type="number"],
    .portal-card textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.95rem;
        margin-bottom: 14px;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }
    .portal-card input:focus, .portal-card textarea:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }
    .portal-card textarea {
        resize: vertical;
        min-height: 80px;
    }
    .btn-emergency {
        background-color: #dc3545;
        color: white;
        border: none;
        width: 100%;
        padding: 14px;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .btn-emergency:hover {
        background-color: #b91c1c;
    }
    .btn-action {
        background-color: #0284c7;
        color: white;
        border: none;
        width: 100%;
        padding: 12px;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .btn-action:hover {
        background-color: #0369a1;
    }
    .location-badge {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        padding: 10px;
        border-radius: 6px;
        font-size: 0.85rem;
        color: #334155;
        margin-bottom: 15px;
        text-align: center;
        font-weight: 500;
    }
    .wallet-card-inner {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        color: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
    .wallet-card-inner h3 {
        color: #38bdf8;
    }
    .success-msg {
        margin-top: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        text-align: center;
    }
</style>

<div class="patient-wrapper">
    <div class="patient-dashboard">
        <!-- Emergency Request Card -->
        <div class="portal-card">
            <h3>🚨 Request Emergency Assistance</h3>
            <p style="color: #64748b; margin-bottom: 15px; font-size: 0.9rem;">
                Instant ambulance dispatch using real-time GPS telemetry.
            </p>

            <div>
                <label>Emergency Details / Symptoms:</label>
                <textarea id="emergencyDescription" placeholder="Briefly describe symptoms (e.g., severe chest pain, accident)..."></textarea>
            </div>

            <div id="location-status" class="location-badge">
                📍 Acquiring your GPS location...
            </div>

            <button id="requestBtn" class="btn-emergency">
                REQUEST AMBULANCE NOW
            </button>
            <div id="status-message" class="success-msg" style="color: #16a34a;"></div>
        </div>

        <!-- Emergency Wallet Card -->
        <div class="portal-card wallet-card-inner">
            <h3>💳 My Emergency Wallet</h3>
            <p style="margin-bottom: 15px; font-size: 0.95rem;">Current Balance: <strong style="font-size: 1.2rem; color: #4ade80;">R <span id="balance-display"><%= user.wallet_balance || '0.00' %></span></strong></p>
            
            <div style="display: flex; gap: 10px;">
                <input type="number" id="topup-amount" placeholder="Amount (e.g. 150)" min="1" step="0.01" style="margin-bottom: 0;">
                <button onclick="topUpWallet()" class="btn-action" style="width: auto; padding: 10px 20px;">Add Funds</button>
            </div>
        </div>
    </div>
</div>

<!-- Socket.io Script Integration -->
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    let userLat = null;
    let userLon = null;

    // Automatically detect and set current date/time in appointment picker if present
    window.addEventListener('DOMContentLoaded', () => {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        const formattedDateTime = now.toISOString().slice(0, 16);
        const dateInput = document.getElementById("appointmentDateInput");
        if (dateInput) {
            dateInput.value = formattedDateTime;
        }
    });

    // Automatically fetch patient GPS coordinates on page load
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                userLat = position.coords.latitude;
                userLon = position.coords.longitude;
                document.getElementById("location-status").innerHTML =
                    `✅ Location acquired: ${userLat.toFixed(4)}, ${userLon.toFixed(4)}`;
            },
            (error) => {
                console.error("Geolocation error:", error);
                document.getElementById("location-status").innerHTML =
                    `⚠️ Precise location unavailable. Using city fallback.`;
                userLat = -33.9249; // Cape Town center fallback
                userLon = 18.4241;
            },
            { enableHighAccuracy: true }
        );
    } else {
        document.getElementById("location-status").innerHTML = "⚠️ Geolocation is not supported by your browser.";
        userLat = -33.9249;
        userLon = 18.4241;
    }

    // Emergency request dispatch handler
    document.getElementById("requestBtn").addEventListener("click", () => {
        if (userLat === null || userLon === null) {
            alert("Please wait while we acquire your GPS location.");
            return;
        }

        const description = document.getElementById("emergencyDescription").value.trim() || "Medical Emergency Request";

        socket.emit("emergency-request", {
            description: description,
            latitude: userLat,
            longitude: userLon
        });

        const statusMsg = document.getElementById("status-message");
        statusMsg.style.color = "#16a34a";
        statusMsg.textContent = "🚨 Emergency broadcast sent! Ambulance dispatch notified.";
        document.getElementById("emergencyDescription").value = "";
    });

    // Listen for server response and hospital matching
    socket.on("new-incident", (data) => {
        const hospInfo = document.getElementById("nearestHospitalInfo");
        if (hospInfo && data.nearestHospital) {
            hospInfo.innerHTML = 
                `Nearest Hospital: <b>${data.nearestHospital.name}</b> (${parseFloat(data.nearestHospital.distance_km).toFixed(2)} km away)`;
        }
        const hospInput = document.getElementById("hospitalNameInput");
        if (hospInput && data.nearestHospital) {
            hospInput.value = data.nearestHospital.name;
        }
        const statusMsg = document.getElementById("status-message");
        statusMsg.textContent = `Incident active! Status: ${data.status}`;
    });

    // Wallet top-up handler
    async function topUpWallet() {
        const amount = document.getElementById('topup-amount').value;
        if (!amount || amount <= 0) {
            alert('Please enter a valid top-up amount.');
            return;
        }
        
        try {
            const response = await fetch('/api/wallet/topup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount: parseFloat(amount) })
            });
            
            const data = await response.json();
            if (data.success) {
                document.getElementById('balance-display').innerText = Number(data.newBalance).toFixed(2);
                document.getElementById('topup-amount').value = '';
                alert('Funds successfully added to your profile!');
            } else {
                alert('Error: ' + data.error);
            }
        } catch (err) {
            console.error('Wallet top-up error:', err);
            alert('Failed to process wallet top-up.');
        }
    }
</script>

<%- include('partials/footer') %>