<%- include('partials/header', { title: 'Patient Emergency Portal' }) %>

<style>
    .patient-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 30px 15px;
        box-sizing: border-box;
    }
    .patient-dashboard {
        width: 100%;
        max-width: 650px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .portal-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        color: #f8fafc;
    }
    .portal-card h3 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 1.2rem;
        color: #0ea5e9;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .portal-card label {
        display: block;
        font-size: 0.875rem;
        font-weight: 600;
        color: #cbd5e1;
        margin-bottom: 6px;
    }
    .portal-card input[type="text"],
    .portal-card input[type="datetime-local"],
    .portal-card input[type="number"],
    .portal-card select,
    .portal-card textarea {
        width: 100%;
        padding: 11px 12px;
        background-color: #0f172a;
        border: 1px solid #334155;
        border-radius: 6px;
        color: #f8fafc;
        font-size: 0.95rem;
        margin-bottom: 14px;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }
    .portal-card input:focus, 
    .portal-card select:focus, 
    .portal-card textarea:focus {
        outline: none;
        border-color: #0ea5e9;
        box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
    }
    .portal-card textarea {
        resize: vertical;
        min-height: 80px;
    }
    .btn-emergency {
        background-color: #e11d48;
        color: white;
        border: none;
        width: 100%;
        padding: 14px;
        font-size: 1rem;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .btn-emergency:hover {
        background-color: #be123c;
    }
    .btn-action {
        background-color: #0ea5e9;
        color: white;
        border: none;
        width: 100%;
        padding: 12px;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .btn-action:hover {
        background-color: #0284c7;
    }
    .location-badge {
        background: #0f172a;
        border: 1px solid #334155;
        padding: 10px;
        border-radius: 6px;
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 15px;
        text-align: center;
        font-weight: 500;
    }
    .wallet-card-inner {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }
    .wallet-flex {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .wallet-flex input {
        flex: 1;
        min-width: 120px;
        margin-bottom: 0 !important;
    }
    .success-msg {
        margin-top: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        text-align: center;
    }
</style>

<div class="patient-wrapper">
    <div class="patient-dashboard">
        
        <!-- 1. Emergency Request Card -->
        <div class="portal-card">
            <h3>🚨 Request Emergency Assistance</h3>
            <p style="color: #94a3b8; margin-bottom: 15px; font-size: 0.9rem;">
                Instant ambulance dispatch using real-time GPS telemetry.
            </p>

            <div>
                <label>Emergency Details / Symptoms:</label>
                <textarea id="emergencyDescription" placeholder="Briefly describe symptoms (e.g., severe chest pain, accident)..."></textarea>
            </div>

            <div id="location-status" class="location-badge">
                📍 Acquiring your GPS location...
            </div>

            <button id="requestBtn" class="btn-emergency">
                REQUEST AMBULANCE NOW
            </button>
            <div id="status-message" class="success-msg" style="color: #4ade80;"></div>
        </div>

        <!-- 2. Doctor Appointment Booking Card -->
        <div class="portal-card">
            <h3>📅 Book Medical Consultation</h3>
            <p style="color: #94a3b8; margin-bottom: 15px; font-size: 0.9rem;">
                Schedule a consultation with an attending medical officer for review.
            </p>

            <form id="appointmentForm">
                <label>Select Date & Time:</label>
                <input type="datetime-local" id="appointmentDateInput" name="appointment_date" required>

                <label>Consultation Notes / Reason:</label>
                <textarea name="symptoms" placeholder="Describe symptoms or reason for visit..."></textarea>

                <label>Select Hospital / Facility:</label>
                <select name="hospital_name" required>
                    <option value="" disabled selected>Select nearest hospital...</option>
                    <option value="Groote Schuur Hospital">Groote Schuur Hospital (Cape Town)</option>
                    <option value="Tygerberg Hospital">Tygerberg Hospital (Bellville)</option>
                    <option value="New Somerset Hospital">New Somerset Hospital (Green Point)</option>
                    <option value="Mediclinic Cape Town">Mediclinic Cape Town</option>
                </select>

                <button type="submit" class="btn-action">BOOK APPOINTMENT</button>
            </form>
            <div id="appointmentResult" class="success-msg" style="color: #4ade80;"></div>
        </div>

        <!-- 3. Emergency Wallet Card -->
        <div class="portal-card wallet-card-inner">
            <h3>💳 My Emergency Wallet</h3>
            <p style="margin-bottom: 15px; font-size: 0.95rem; color: #cbd5e1;">Current Balance: <strong style="font-size: 1.2rem; color: #4ade80;">R <span id="balance-display"><%= user.wallet_balance || '0.00' %></span></strong></p>
            
            <div class="wallet-flex">
                <input type="number" id="topup-amount" placeholder="Amount (e.g. 150)" min="1" step="0.01">
                <button onclick="topUpWallet()" class="btn-action" style="width: auto; padding: 10px 20px;">Add Funds</button>
            </div>
        </div>

    </div>
</div>

<!-- Socket.io Script Integration -->
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    let userLat = null;
    let userLon = null;

    window.addEventListener('DOMContentLoaded', () => {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        const formattedDateTime = now.toISOString().slice(0, 16);
        const dateInput = document.getElementById("appointmentDateInput");
        if (dateInput) {
            dateInput.value = formattedDateTime;
        }
    });

    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                userLat = position.coords.latitude;
                userLon = position.coords.longitude;
                document.getElementById("location-status").innerHTML =
                    `✅ Location acquired: ${userLat.toFixed(4)}, ${userLon.toFixed(4)}`;
            },
            (error) => {
                console.error("Geolocation error:", error);
                document.getElementById("location-status").innerHTML =
                    `⚠️ Precise location unavailable. Using city fallback.`;
                userLat = -33.9249; 
                userLon = 18.4241;
            },
            { enableHighAccuracy: true }
        );
    } else {
        document.getElementById("location-status").innerHTML = "⚠️ Geolocation is not supported by your browser.";
        userLat = -33.9249;
        userLon = 18.4241;
    }

    document.getElementById("requestBtn").addEventListener("click", () => {
        if (userLat === null || userLon === null) {
            alert("Please wait while we acquire your GPS location.");
            return;
        }

        const description = document.getElementById("emergencyDescription").value.trim() || "Medical Emergency Request";

        socket.emit("emergency-request", {
            description: description,
            latitude: userLat,
            longitude: userLon
        });

        const statusMsg = document.getElementById("status-message");
        statusMsg.style.color = "#4ade80";
        statusMsg.textContent = "🚨 Emergency broadcast sent! Ambulance dispatch notified.";
        document.getElementById("emergencyDescription").value = "";
    });

    socket.on("new-incident", (data) => {
        const statusMsg = document.getElementById("status-message");
        statusMsg.textContent = `Incident active! Status: ${data.status}`;
    });

    document.getElementById("appointmentForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const body = Object.fromEntries(formData);

        try {
            const res = await fetch("/api/book-appointment", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body)
            });
            const result = await res.json();
            if (result.success) {
                document.getElementById("appointmentResult").innerText = "✅ Appointment booked successfully! Pending medical review.";
                e.target.reset();
            } else {
                document.getElementById("appointmentResult").innerText = "⚠️ Booking failed: " + (result.error || "Unknown error");
            }
        } catch (err) {
            console.error("Booking error:", err);
            document.getElementById("appointmentResult").innerText = "❌ Error submitting appointment.";
        }
    });

    async function topUpWallet() {
        const amount = document.getElementById('topup-amount').value;
        if (!amount || amount <= 0) {
            alert('Please enter a valid top-up amount.');
            return;
        }
        
        try {
            const response = await fetch('/api/wallet/topup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount: parseFloat(amount) })
            });
            
            const data = await response.json();
            if (data.success) {
                document.getElementById('balance-display').innerText = Number(data.newBalance).toFixed(2);
                document.getElementById('topup-amount').value = '';
                alert('Funds successfully added to your profile!');
            } else {
                alert('Error: ' + data.error);
            }
        } catch (err) {
            console.error('Wallet top-up error:', err);
            alert('Failed to process wallet top-up.');
        }
    }
</script>

<%- include('partials/footer') %>