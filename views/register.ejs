<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Patient Registration | Ambulance Tracking System</title>
    <link rel="stylesheet" href="/css/style.css" />
    <style>
      body {
        background-color: #0f172a;
        color: #f8fafc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      header, footer {
        background-color: #1e293b;
        border-color: #334155;
      }
    </style>
  </head>
  <body>
    <!-- Top Navigation Bar -->
    <header>
      <div class="brand">
        <span class="status-indicator"></span>
        <span>EMS Command Portal</span>
      </div>
      <div class="system-status">Patient Registration</div>
    </header>

    <!-- Main Authentication Card -->
    <main>
      <div
        class="hero-card"
        style="width: 100%; max-width: 28rem; background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 30px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);"
      >
        <h1
          style="font-size: 1.75rem; text-align: center; margin-bottom: 0.5rem; color: #0ea5e9;"
        >
          Create Account
        </h1>
        <p style="text-align: center; font-size: 0.875rem; margin-bottom: 2rem; color: #94a3b8;">
          Register to access emergency dispatch and patient services.
        </p>

        <% if (locals.error && error) { %>
            <div style="background-color: rgba(225, 29, 72, 0.15); border: 1px solid #e11d48; color: #f43f5e; padding: 10px; border-radius: 6px; margin-bottom: 15px; font-size: 14px; text-align: center;"><%= error %></div>
        <% } %>

        <form
          action="/register"
          method="POST"
          style="display: flex; flex-direction: column; gap: 1.25rem"
        >
          <div>
            <label style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: #cbd5e1;">Username</label>
            <input
              type="text"
              name="username"
              required
              placeholder="Enter your username"
              style="width: 100%; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #334155; background-color: #0f172a; color: #f8fafc; font-size: 0.95rem; box-sizing: border-box;"
            />
          </div>

          <div>
            <label style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: #cbd5e1;">Email Address</label>
            <input
              type="email"
              name="email"
              required
              placeholder="Enter your email"
              style="width: 100%; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #334155; background-color: #0f172a; color: #f8fafc; font-size: 0.95rem; box-sizing: border-box;"
            />
          </div>

          <div>
            <label style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: #cbd5e1;">Password</label>
            <input
              type="password"
              name="password"
              required
              placeholder="Enter your password"
              style="width: 100%; padding: 0.75rem; border-radius: 0.5rem; border: 1px solid #334155; background-color: #0f172a; color: #f8fafc; font-size: 0.95rem; box-sizing: border-box;"
            />
          </div>

          <button
            type="submit"
            class="btn btn-patient"
            style="width: 100%; margin-top: 0.5rem; cursor: pointer; border: none; padding: 0.75rem; font-weight: bold; background-color: #0ea5e9; color: white; border-radius: 0.5rem; transition: background-color 0.2s;"
          >
            Register & Proceed
          </button>
        </form>

        <div style="margin-top: 20px; text-align: center; font-size: 14px; color: #94a3b8;">
            Already have an account? <a href="/login" style="color: #0ea5e9; text-decoration: none; font-weight: 600;">Log in here</a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer>
      Ambulance Tracking System &copy; 2026 | Secure Telemetry Feed
    </footer>
  </body>
</html>