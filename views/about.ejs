<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Ambulance Tracking System - About</title>
    <link rel="stylesheet" href="/css/style.css"> <!-- optional -->
</head>
<body>
    <header>
        <h1>Ambulance Tracking & Emergency Dispatch System</h1>
    </header>
    
    <main style="padding: 20px;">
        <section>
            <h2>Welcome to the Cape Town Emergency Response Platform</h2>
            <p>Real-time ambulance dispatch, nearest hospital facility matching, and instant emergency medical consultations.</p>
        </section>

        <section style="margin-top: 30px;">
            <!-- Protected Action Buttons -->
            <a href="/patient"><button>Patient Portal (Request Ambulance)</button></a>
            <a href="/driver"><button>Driver Dashboard</button></a>
            <a href="/consultation"><button>Online Medical Consultation</button></a>
            
            <% if (!locals.user) { %>
                <div style="margin-top: 15px;">
                    <a href="/login">Log In</a> | <a href="/register">Register</a>
                </div>
            <% } %>
        </section>
    </main>
</body>
</html>