<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Portal Login - EMS</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0f172a; color: #f8fafc; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .card { background: #1e293b; border: 1px solid #334155; padding: 40px; border-radius: 12px; width: 400px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        h2 { color: #0ea5e9; margin-bottom: 20px; text-align: center; }
        label { display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px; }
        input { width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: white; margin-bottom: 15px; box-sizing: border-box; }
        button { width: 100%; background: #0ea5e9; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        button:hover { background: #0284c7; }
        .error { color: #f43f5e; font-size: 0.85rem; margin-bottom: 15px; text-align: center; }
        .link { text-align: center; margin-top: 15px; font-size: 0.85rem; color: #94a3b8; }
        .link a { color: #38bdf8; text-decoration: none; }
    </style>
</head>
<body>
    <div class="card">
        <h2>🛡️ Admin Command Login</h2>
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <form action="/admin-login" method="POST">
            <label>Admin Email:</label>
            <input type="email" name="email" placeholder="admin@ems.co.za" required>
            
            <label>Password:</label>
            <input type="password" name="password" placeholder="••••••••" required>
            
            <button type="submit">Access Command Center</button>
        </form>
        <div class="link">
            Need an admin account? <a href="/admin-register">Register here</a>
        </div>
    </div>
</body>
</html>