<nav>
    <a href="/">Home</a>
    <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.userType === 'patient') { %>
            <a href="/patient">Dashboard</a>
            <a href="/consultation">Consultation</a>
        <% } else if (user.userType === 'driver') { %>
            <a href="/driver">Driver Dashboard</a>
        <% } else if (user.userType === 'staff') { %>
            <a href="/admin">Admin Dashboard</a>
        <% } %>
        <a href="/logout" style="color: #f43f5e; font-weight: 600;">Logout</a>
    <% } else { %>
        <a href="/login">Patient Login</a>
        <a href="/driver-login">Driver Portal</a>
        <a href="/admin-login">Admin Portal</a>
    <% } %>
</nav>