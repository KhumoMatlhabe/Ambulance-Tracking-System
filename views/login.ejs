<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Patient Login - Ambulance Tracking System</title>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #0f172a; 
            color: #f8fafc;
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
        }
        .login-card { 
            background-color: #1e293b; 
            border: 1px solid #334155;
            padding: 30px; 
            border-radius: 12px; 
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3); 
            width: 100%; 
            max-width: 400px; 
            box-sizing: border-box;
        }
        h2 { 
            margin-top: 0;
            margin-bottom: 8px; 
            color: #0ea5e9; 
            text-align: center; 
            font-size: 1.75rem;
        }
        .subtitle {
            color: #94a3b8;
            font-size: 0.875rem;
            text-align: center;
            margin-bottom: 24px;
        }
        .error-msg { 
            background-color: rgba(225, 29, 72, 0.15); 
            border: 1px solid #e11d48; 
            color: #f43f5e; 
            padding: 10px; 
            border-radius: 6px;
            margin-bottom: 16px; 
            font-size: 0.85rem; 
            text-align: center; 
        }
        label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 6px;
            color: #cbd5e1;
        }
        input { 
            width: 100%; 
            padding: 11px 14px; 
            margin-bottom: 16px; 
            background-color: #0f172a;
            border: 1px solid #334155; 
            border-radius: 6px; 
            color: #f8fafc;
            font-size: 0.95rem;
            box-sizing: border-box; 
            transition: border-color 0.2s;
        }
        input:focus {
            outline: none;
            border-color: #0ea5e9;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
        }
        button { 
            width: 100%; 
            padding: 12px; 
            background-color: #0ea5e9; 
            color: white; 
            border: none; 
            border-radius: 6px; 
            font-weight: 600; 
            font-size: 1rem;
            cursor: pointer; 
            margin-top: 4px;
            transition: background-color 0.2s;
        }
        button:hover { 
            background-color: #0284c7; 
        }
        .links { 
            margin-top: 20px; 
            text-align: center; 
            font-size: 0.85rem; 
            color: #94a3b8; 
            line-height: 1.6;
        }
        .links a { 
            color: #0ea5e9; 
            text-decoration: none; 
            font-weight: 600;
        }
        .links a:hover { 
            text-decoration: underline; 
        }
    </style>
</head>
<body>
    <div class="login-card">
        <h2>Sign In</h2>
        <p class="subtitle">Access your emergency portal and wallet</p>
        
        <% if (error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
            <label>Email Address</label>
            <input type="email" name="email" placeholder="Enter your email" required />
            
            <label>Password</label>
            <input type="password" name="password" placeholder="Enter your password" required />
            
            <button type="submit">Log In</button>
        </form>

        <div class="links">
            Don't have an account? <a href="/register">Register here</a><br>
            <a href="/">Back to Home</a>
        </div>
    </div>
</body>
</html>