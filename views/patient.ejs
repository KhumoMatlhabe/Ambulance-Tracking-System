<%- include('partials/header', { title: 'Patient Emergency Portal' }) %>

<div class="card">
    <h3>🚨 Request Emergency Assistance</h3>
    <p style="color: #b8c1ec; margin-bottom: 15px; font-size: 0.95rem;">
        Request immediate ambulance dispatch to your current GPS coordinates.
    </p>

    <div style="text-align: left; margin-bottom: 15px;">
        <label>Emergency Details / Symptoms:</label>
        <textarea id="emergencyDescription" placeholder="Briefly describe the medical emergency (e.g., severe chest pain, accident)..."></textarea>
    </div>

    <div id="location-status" style="background: #0f3460; padding: 10px; border-radius: 6px; font-size: 0.85rem; color: #b8c1ec; margin-bottom: 15px; text-align: center;">
        📍 Acquiring your GPS location...
    </div>

    <button id="requestBtn" style="background-color: #dc3545; width: 100%; padding: 14px; font-size: 1rem;">
        REQUEST AMBULANCE NOW
    </button>
    <div id="status-message" class="success-msg"></div>
</div>

<div class="card">
    <h3>🏥 Book Appointment at Nearest Hospital</h3>
    <p id="nearestHospitalInfo" style="margin-bottom: 15px;">Detecting nearest hospital facility...</p>
    
    <form id="appointmentForm">
        <input type="hidden" id="hospitalNameInput" name="hospitalName">
        
        <label>Department:</label>
        <input type="text" name="department" placeholder="e.g., Emergency, Trauma, Cardiology" required>
        
        <label>Date & Time:</label>
        <input type="datetime-local" name="appointmentDate" required>
        
        <button type="submit" style="width: 100%;">Confirm Hospital Appointment</button>
    </form>
    <div id="appointmentResult" class="success-msg"></div>
</div>

<!-- Socket.io Script Integration -->
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    let userLat = null;
    let userLon = null;

    // Automatically fetch patient GPS coordinates on page load
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
            (position) => {
                userLat = position.coords.latitude;
                userLon = position.coords.longitude;
                document.getElementById("location-status").innerHTML =
                    `✅ Location acquired: ${userLat.toFixed(4)}, ${userLon.toFixed(4)}`;
            },
            (error) => {
                console.error("Geolocation error:", error);
                document.getElementById("location-status").innerHTML =
                    `⚠️ Could not get precise location. Using default city coordinates.`;
                userLat = -33.9249; // Cape Town center fallback
                userLon = 18.4241;
            },
            { enableHighAccuracy: true }
        );
    } else {
        document.getElementById("location-status").innerHTML = "⚠️ Geolocation is not supported by your browser.";
        userLat = -33.9249;
        userLon = 18.4241;
    }

    // Emergency request dispatch handler
    document.getElementById("requestBtn").addEventListener("click", () => {
        if (userLat === null || userLon === null) {
            alert("Please wait while we acquire your GPS location.");
            return;
        }

        const description = document.getElementById("emergencyDescription").value.trim() || "Medical Emergency Request";

        socket.emit("emergency-request", {
            description: description,
            latitude: userLat,
            longitude: userLon
        });

        const statusMsg = document.getElementById("status-message");
        statusMsg.style.color = "#28a745";
        statusMsg.textContent = "🚨 Emergency broadcast sent! Ambulance dispatch has been notified.";
        document.getElementById("emergencyDescription").value = "";
    });

    // Listen for server response and hospital matching
    socket.on("new-incident", (data) => {
        if (data.nearestHospital) {
            document.getElementById("nearestHospitalInfo").innerHTML = 
                `Nearest Hospital: <b>${data.nearestHospital.name}</b> (${parseFloat(data.nearestHospital.distance_km).toFixed(2)} km away)`;
            document.getElementById("hospitalNameInput").value = data.nearestHospital.name;
        }
        const statusMsg = document.getElementById("status-message");
        statusMsg.textContent = `Incident active! Status: ${data.status}`;
    });

    socket.on("broadcast-alert", (data) => {
        console.log("Ambulance update:", data.message);
    });

    // Appointment booking form submission
    document.getElementById("appointmentForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const body = Object.fromEntries(formData);

        try {
            const res = await fetch("/api/book-appointment", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body)
            });
            const result = await res.json();
            if (result.success) {
                document.getElementById("appointmentResultinnerText").innerText = "Appointment booked successfully!";
            } else {
                document.getElementById("appointmentResult").innerText = "Booking failed.";
            }
        } catch (err) {
            console.error("Booking error:", err);
            document.getElementById("appointmentResult").innerText = "Error submitting appointment.";
        }
    });
</script>
<div class="wallet-card">
    <h3>My Emergency Wallet</h3>
    <p>Current Balance: <strong>R <span id="balance-display"><%= user.wallet_balance || '0.00' %></span></strong></p>
    
    <div class="topup-form">
        <input type="number" id="topup-amount" placeholder="Amount (e.g. 150)" min="1" step="0.01">
        <button onclick="topUpWallet()">Add Funds</button>
    </div>
</div>

<script>
async function topUpWallet() {
    const amount = document.getElementById('topup-amount').value;
    
    const response = await fetch('/api/wallet/topup', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount: parseFloat(amount) })
    });
    
    const data = await response.json();
    if (data.success) {
        document.getElementById('balance-display').innerText = Number(data.newBalance).toFixed(2);
        alert('Funds successfully added to your profile!');
    } else {
        alert('Error: ' + data.error);
    }
}
</script>

<%- include('partials/footer') %>