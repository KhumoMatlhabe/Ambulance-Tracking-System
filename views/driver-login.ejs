<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Driver Login - EMS Command</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f172a; color: #f8fafc; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-card { background: #1e293b; padding: 40px; border-radius: 12px; border: 1px solid #334155; width: 100%; max-width: 400px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); }
        h2 { color: #38bdf8; margin-top: 0; margin-bottom: 20px; text-align: center; }
        label { display: block; font-size: 0.85rem; font-weight: 600; color: #94a3b8; margin-bottom: 6px; }
        input { width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: white; font-size: 0.95rem; margin-bottom: 20px; box-sizing: border-box; }
        input:focus { outline: none; border-color: #0ea5e9; }
        button { background: #0ea5e9; color: white; border: none; width: 100%; padding: 12px; font-weight: bold; border-radius: 6px; cursor: pointer; transition: background 0.2s; }
        button:hover { background: #0284c7; }
        .error-msg { color: #f43f5e; font-size: 0.85rem; text-align: center; margin-bottom: 15px; }
        .back-link { text-align: center; margin-top: 15px; font-size: 0.85rem; }
        .back-link a { color: #38bdf8; text-decoration: none; }
    </style>
</head>
<body>
    <div class="login-card">
        <h2>🚑 Driver Portal Login</h2>
        <% if (error) { %>
            <div class="error-msg"><%= error %></div>
        <% %>
        <form action="/driver-login" method="POST">
            <label>Driver Email:</label>
            <input type="email" name="email" placeholder="driver@ems.co.za" required>
            
            <label>Password:</label>
            <input type="password" name="password" placeholder="••••••••" required>
            
            <button type="submit">Sign In to Dashboard</button>
        </form>
        <div class="back-link">
            <a href="/">← Return to Home</a>
        </div>
    </div>
</body>
</html>